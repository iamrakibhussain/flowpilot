# ==============================================================================
# FlowPilot Frontend — Environment Variable Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development.
# In production (e.g. Vercel), configure these in Project Settings -> Environment Variables.
# NEVER commit sensitive credentials or live secret keys to version control.
# ==============================================================================

# Application Environment ('development' | 'staging' | 'production' | 'test')
NEXT_PUBLIC_APP_ENV=development

# Web Application Canonical Origin URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# flowpilot-backend Express REST API Base URL
# In local dev: http://localhost:4000/api/v1
# In production: https://api.yourdomain.com/api/v1 (or backend service URL proxied via Next.js rewrites)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# HTTP Request Timeout (in milliseconds)
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Isolated Architecture Verification Mock Mode (MUST be false in production)
NEXT_PUBLIC_ENABLE_MOCKS=false

# Stripe Public / Publishable Key (Test Mode: pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
