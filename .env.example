# FlowPilot Frontend Environment Variables
# Copy to .env.local for local development. Never commit sensitive credentials.

# Application Environment (development | staging | production | test)
NEXT_PUBLIC_APP_ENV=development

# Web Application Origin URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# flowpilot-backend Express REST API Base URL (Separate backend service)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# HTTP Request Timeout (in milliseconds)
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Isolated Architecture Verification Mock Mode (false in production)
NEXT_PUBLIC_ENABLE_MOCKS=false
